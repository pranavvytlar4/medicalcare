# Application Port (Automatically provided by Vercel/Cloud host)
PORT=5000

# MongoDB Atlas Cloud Database URI
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-url>/medical_care_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_password@cluster0.xxxxx.mongodb.net/medical_care_db?retryWrites=true&w=majority

# Security Secrets (Replace with random strings in production)
JWT_SECRET=medical_care_jwt_super_secret_key_2026_production
SESSION_SECRET=medical_care_session_secret_key_2026_production

# Node Environment
NODE_ENV=production

# Optional: Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Optional: Email Service (Gmail App Password)
EMAIL_USER=
EMAIL_PASS=
